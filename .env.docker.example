# Copy this file to .env (same folder as compose.yaml) before running
# `docker compose up`. Never commit the real .env file.
#
# These values are consumed by compose.yaml itself (Postgres
# credentials) — the api/dashboard containers get DATABASE_URL and
# API_URL built for them automatically, you don't set those here.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ai_reliability_platform

# Optional, defaults to 20 if unset
KB_MAX_UPLOAD_MB=20
